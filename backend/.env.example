# Modèle des secrets du backend. Copier en .env (gitignoré) et remplir.

# Node-RED : clé de chiffrement de flows_cred.json (même valeur sur toutes les machines).
NODE_RED_CREDENTIAL_SECRET=change-me

# InfluxDB 2.x : initialisation automatique au premier démarrage.
INFLUXDB_USERNAME=admin
INFLUXDB_PASSWORD=change-me-min-8-chars
INFLUXDB_ORG=sesame
INFLUXDB_BUCKET=sesame
INFLUXDB_RETENTION=30d
INFLUXDB_TOKEN=change-me

# HiveMQ Cloud : identifiant dédié à Node-RED.
MQTT_HOST=xxxxxxxx.s1.eu.hivemq.cloud
MQTT_PORT=8883
MQTT_USERNAME=nodered
MQTT_PASSWORD=change-me
